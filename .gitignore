dist/
build/
*.dist

# ── Environment variables (NEVER commit real .env) ────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── IDE and editor files ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime data ──────────────────────────────────────────────────────────────
pids
*.pid
*.seed
*.pid.lock
*.bak

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output

# ── TypeScript cache ──────────────────────────────────────────────────────────
*.tsbuildinfo

