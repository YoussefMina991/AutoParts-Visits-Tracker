.npm
.eslintcache
.rpt2_cache/
.rts2_cache_*/
.node_repl_history
*.tgz
.yarn-integrity
.cache
.parcel-cache

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Uploaded files (local dev only) ──────────────────────────────────────────
uploads/

